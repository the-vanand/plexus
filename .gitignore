# --- зависимости и сборка ---
node_modules
dist
*.local

# --- Rust / Tauri ---
src-tauri/target
src-tauri/gen
# разрешения команд приложения порождает tauri-build по списку из build.rs
src-tauri/permissions/autogenerated

# --- результаты прогонов стендов ---
# Стенды пишут сюда готовые сайты, скриншоты и промежуточные файлы.
# Это артефакты, а не исходники: пересобираются одной командой.
out/

# --- архивы сборок ---
*.zip

# --- материалы заказчика ---
# Полноразмерные фото реального сайта (2.5 МБ). Для регрессий достаточно
# облегчённой копии fixtures/cospex-lite и снимка fixtures/snapshots.
# Если репозиторий приватный и фото нужны — убери строку ниже.
fixtures/cospex-site/

# --- IDE / OS ---
.DS_Store
Thumbs.db
.idea
*.swp

# --- служебные копии агентов ---
# Изолированные worktree, в которых работают агенты. Не исходники.
.claude/

# --- иконки приложения ---
# Генерируются из design/icon.svg командой `npm run icons` и автоматически
# после `npm install`. В репозитории лежит источник, а не бинарные копии:
# так их нельзя рассинхронизировать, а история не пухнет от PNG и ICNS.
src-tauri/icons/

# Растровая копия иконки: источник — design/icon.svg, копия избыточна.
design/app-icon.png
